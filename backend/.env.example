# ─── LOCAL (SQLite — aucune installation requise) ────────────────────────────
DATABASE_URL=sqlite:///./isoko.db

# ─── PRODUCTION (PostgreSQL en ligne — décommenter et remplir) ───────────────
# DATABASE_URL=postgresql://user:password@host:5432/isoko_db
#
# Exemples de providers gratuits :
#   Supabase  → postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#   Railway   → postgresql://postgres:[PASSWORD]@[HOST]:5432/railway
#   Render    → postgresql://[USER]:[PASSWORD]@[HOST]/[DB]  (auto-corrigé)

SECRET_KEY=supersecretkey_changeme_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads

SUPABASE_URL=45454545
SUPABASE_ANON_KEY=454545
SUPABASE_SERVICE_ROLE_KEY=454545